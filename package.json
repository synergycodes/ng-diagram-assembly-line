{
  "name": "ng-diagram-assembly-line",
  "version": "1.0.0",
  "description": "Interactive assembly-line monitoring template built with Angular and ng-diagram",
  "license": "MIT",
  "private": true,
  "keywords": [
    "visualization",
    "open-source",
    "angular",
    "typescript",
    "graph",
    "drag-and-drop",
    "diagram",
    "diagramming",
    "node-editor",
    "node-based-ui",
    "ng-diagram",
    "assembly-line",
    "manufacturing",
    "production-monitoring"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/synergycodes/ng-diagram-assembly-line.git"
  },
  "homepage": "https://www.ngdiagram.dev",
  "packageManager": "npm@10.9.2",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --no-watch",
    "test:watch": "ng test",
    "lint": "ng lint",
    "type-check": "tsc -b --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@angular/common": "21.2.9",
    "@angular/compiler": "21.2.9",
    "@angular/core": "21.2.9",
    "@angular/forms": "21.2.9",
    "@angular/platform-browser": "21.2.9",
    "@angular/router": "21.2.9",
    "@ngx-formly/core": "^7.1.0",
    "html-to-image": "^1.11.13",
    "ng-diagram": "^1.3.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "21.2.7",
    "@angular/cli": "21.2.7",
    "@angular/compiler-cli": "21.2.9",
    "@angular/language-service": "21.2.9",
    "@eslint/js": "^9.8.0",
    "@types/node": "20.19.9",
    "@vitest/coverage-v8": "4.0.9",
    "angular-eslint": "22.1.0",
    "eslint": "^9.8.0",
    "eslint-config-prettier": "^10.0.0",
    "jsdom": "~22.1.0",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.40.0",
    "vite": "^7.3.2",
    "vitest": "4.0.9"
  }
}
